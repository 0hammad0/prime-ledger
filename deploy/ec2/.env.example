# Enterprise deploy env — copy to .env and chmod 600.
# NEVER commit .env

ERPNEXT_VERSION=v16.29.0
# Optional: white-labeled image built from deploy/docker/Dockerfile
# CUSTOM_IMAGE=prime-ledger/erpnext:v16.29.0
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

FRAPPE_SITE_NAME_HEADER=frontend
SITE_NAME=frontend

# Public HTTPS hostname (sslip.io or your domain)
PUBLIC_HOST=65.1.92.180.sslip.io
SITES_RULE='Host(`65.1.92.180.sslip.io`)'
LETSENCRYPT_EMAIL=security@example.com

HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443

# Capacity (t3.small Free Tier)
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
PROXY_READ_TIMEOUT=120

PULL_POLICY=missing
RESTART_POLICY=unless-stopped
BACKUP_CRONSTRING="@every 6h"

# Optional offsite backups (install awscli + IAM role/keys on the instance)
# AWS_S3_BACKUP_URI=s3://your-bucket/prime-ledger
